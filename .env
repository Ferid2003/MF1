# Resource Service Envs
RESOURCE_SERVICE_NAME=resource-service
RESOURCE_SERVICE_PORT=8080

# Resource DB Envs
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource-db
RESOURCE_DB_INTERNAL_PORT=5432
RESOURCE_DB_EXPOSE_PORT=5434
RESOURCE_DB_NAME=resource-db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres

# Song Service Envs
SONG_SERVICE_NAME=song-service
SONG_SERVICE_PORT=8081

# Song DB Envs
SONG_DB_URL=jdbc:postgresql://song-db:5432/song-db
SONG_DB_INTERNAL_PORT=5432
SONG_DB_EXPOSE_PORT=5433
SONG_DB_NAME=song-db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres

# Storage Service Envs
STORAGE_SERVICE_NAME=storage-service
STORAGE_SERVICE_PORT=8084

# Storage DB Envs
STORAGE_DB_URL=jdbc:postgresql://storage-db:5432/storage-db
STORAGE_DB_INTERNAL_PORT=5432
STORAGE_DB_EXPOSE_PORT=5435
STORAGE_DB_NAME=storage-db
STORAGE_DB_USER=postgres
STORAGE_DB_PASSWORD=postgres

# Eureka Service Envs
EUREKA_SERVICE_NAME=eureka-service
EUREKA_SERVICE_PORT=8761

# Gateway Service Envs
GATEWAY_PORT=8085

# AWS / LocalStack S3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_ENDPOINT=http://localstack:4566
S3_PORT=4566

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_CONSOLE_PORT=15672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_EXCHANGE=exchange-name
RABBITMQ_ROUTING_KEY=routing-key
RABBITMQ_QUEUE=queue-name

RESOURCE_PROCESSOR_PORT=8083

CONFIG_SERVICE_PORT=8888
CONFIG_SERVICE_URI=https://github.com/Ferid2003/MF1_ConfigRepo

CONFIG_SERVER=optional:configserver:http://config-service:8888

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging (ELK) host ports; containers always listen on 9200 / 5601
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
